From 2222222222222222222222222222222222222222 Mon Sep 17 00:00:00 2001
From: Arnav <arnav@localhost>
Date: Wed, 15 Oct 2026 10:20:00 +0530
Subject: [PATCH] Set FEATURE_JDM_HAL true and disable UDFPS flags

---
 .../com/android/server/biometrics/SemBiometricFeature.smali   | 4 ++--
 .../fingerprint/SemFingerprintServiceExtImpl.smali            | 6 +++---
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/smali/com/android/server/biometrics/SemBiometricFeature.smali b/smali/com/android/server/biometrics/SemBiometricFeature.smali
--- a/smali/com/android/server/biometrics/SemBiometricFeature.smali
+++ b/smali/com/android/server/biometrics/SemBiometricFeature.smali
@@ -200,7 +200,7 @@
 
     const-string/jumbo v1, "jdm"
 
-    invoke-virtual {v0, v1}, Ljava/lang/String;->contains(Ljava/lang/CharSequence;)Z
+    const/4 v0, 0x1
 
-    move-result v0
+    nop
 
     sput-boolean v0, Lcom/android/server/biometrics/SemBiometricFeature;->FEATURE_JDM_HAL:Z
diff --git a/smali/com/android/server/biometrics/sensors/fingerprint/SemFingerprintServiceExtImpl.smali b/smali/com/android/server/biometrics/sensors/fingerprint/SemFingerprintServiceExtImpl.smali
--- a/smali/com/android/server/biometrics/sensors/fingerprint/SemFingerprintServiceExtImpl.smali
+++ b/smali/com/android/server/biometrics/sensors/fingerprint/SemFingerprintServiceExtImpl.smali
@@ -350,9 +350,9 @@
 
-    sget-boolean v0, Lcom/android/server/biometrics/SemBiometricFeature;->FP_FEATURE_SENSOR_IS_ULTRASONIC:Z
+    const/4 v0, 0x0
 
     iput-boolean v0, p0, Lcom/android/server/biometrics/sensors/fingerprint/SemFingerprintServiceExtImpl;->mHasUltrasonicUdfps:Z
 
-    sget-boolean v0, Lcom/android/server/biometrics/SemBiometricFeature;->FP_FEATURE_SENSOR_IS_OPTICAL:Z
+    const/4 v0, 0x0
 
     iput-boolean v0, p0, Lcom/android/server/biometrics/sensors/fingerprint/SemFingerprintServiceExtImpl;->mHasOpticalUdfps:Z
 
-    sget-boolean v0, Lcom/android/server/biometrics/SemBiometricFeature;->FP_FEATURE_SENSOR_IS_IN_DISPLAY_TYPE:Z
+    const/4 v0, 0x0
 
     iput-boolean v0, p0, Lcom/android/server/biometrics/sensors/fingerprint/SemFingerprintServiceExtImpl;->mHasUdfps:Z
-- 
2.51.2
